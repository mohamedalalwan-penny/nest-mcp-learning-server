{
  "name": "nest-mcp-learning-server",
  "version": "1.0.0",
  "private": true,
  "description": "A small Nx, NestJS, MongoDB, Angular, Gemini, and MCP books application.",
  "license": "MIT",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "nx run-many -t build -p api web",
    "build:web:render": "node tools/write-web-config.mjs && nx build web --configuration=production",
    "dev": "nx run-many -t serve -p api web --parallel=2",
    "dev:api": "nx serve api",
    "dev:web": "nx serve web",
    "start:prod": "node dist/apps/api/main.js",
    "lint": "nx run-many -t lint -p api web contracts",
    "test": "nx run-many -t test -p api web",
    "test:api": "nx test api --runInBand",
    "test:web": "nx test web",
    "verify:live": "node --env-file=.env tools/verify-live.mjs"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "^5.0.34",
    "@ai-sdk/mcp": "^2.0.18",
    "@angular/common": "21.2.18",
    "@angular/compiler": "21.2.18",
    "@angular/core": "21.2.18",
    "@angular/forms": "21.2.18",
    "@angular/platform-browser": "21.2.18",
    "@angular/router": "21.2.18",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.5",
    "ai": "^7.0.41",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "marked": "^17.0.1",
    "mongoose": "^9.8.1",
    "ngx-markdown": "^21.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.3.0",
    "zod": "4.4.3"
