    "@nestjs/testing": "11.1.28",
    "@nx/angular": "^23.1.0",
    "@nx/devkit": "^23.1.0",
    "@nx/eslint": "^23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/jest": "^23.1.0",
    "@nx/js": "^23.1.0",
    "@nx/nest": "^23.1.0",
    "@nx/node": "23.1.0",
    "@nx/web": "23.1.0",
